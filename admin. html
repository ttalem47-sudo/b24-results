<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>لوحة المشرف - معرض نتائج الدفعة</title>
<link rel="icon" href="logo.png">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<style>
:root{--navy:#0B2A5B;--sky:#1E9BE8;--soft:#EEF4FB;--red:#d93a3a}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
body{font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic",Arial,sans-serif;background:#fff;color:var(--navy);padding:env(safe-area-inset-top) 16px 40px}
.wrap{max-width:900px;margin:0 auto}
header{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid #dfe8f3;margin-bottom:18px}
header img{height:34px}header h1{flex:1;font-size:19px}
a.lnk,button{font:inherit;cursor:pointer}
.btn{border:0;border-radius:12px;padding:12px 18px;font-weight:700;background:var(--soft);color:var(--navy);text-decoration:none;display:inline-block}
.btn.pri{background:var(--navy);color:#fff}.btn.sky{background:var(--sky);color:#fff}.btn.del{background:#fdeaea;color:var(--red)}
.btn:disabled{opacity:.5}
#login{max-width:340px;margin:60px auto;text-align:center}
#login img{width:200px;margin-bottom:18px}
input{width:100%;padding:13px;margin:6px 0;border:1.5px solid #cfdcec;border-radius:12px;font:inherit;direction:ltr;text-align:left}
#panel{display:none}
#drop{border:2px dashed #9fc3ea;border-radius:18px;background:var(--soft);padding:30px 16px;text-align:center;transition:.15s}
#drop.hot{background:#dcebfb;border-color:var(--sky)}
#drop p{margin:8px 0 14px;color:#4a6a98}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:8px;margin:14px 0}
.cell{position:relative;aspect-ratio:1;border-radius:10px;overflow:hidden;background:var(--soft)}
.cell img{width:100%;height:100%;object-fit:cover;display:block}
.cell button{position:absolute;top:4px;left:4px;width:28px;height:28px;border:0;border-radius:50%;background:rgba(11,42,91,.85);color:#fff;font-size:14px}
.cell.ok::after{content:"✓";position:absolute;inset:0;background:rgba(30,155,232,.7);color:#fff;display:grid;place-items:center;font-size:30px}
.cell.bad::after{content:"✕";position:absolute;inset:0;background:rgba(217,58,58,.7);color:#fff;display:grid;place-items:center;font-size:30px}
.bar{height:8px;background:var(--soft);border-radius:9px;overflow:hidden;margin:10px 0;display:none}
.bar i{display:block;height:100%;width:0;background:var(--sky);transition:width .2s}
h2{font-size:17px;margin:26px 0 4px}
#msg{color:#4a6a98;font-size:14px;min-height:20px}
#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;padding:10px 18px;border-radius:99px;font-size:14px;display:none;z-index:9}
</style>
</head>
<body>
<div class="wrap">

<section id="login">
  <img src="logo.png" alt="B24 Portal">
  <h2 style="margin:0 0 10px">دخول المشرف</h2>
  <input id="em" type="email" placeholder="البريد الإلكتروني" autocomplete="username">
  <input id="pw" type="password" placeholder="كلمة المرور" autocomplete="current-password">
  <button class="btn pri" id="doLogin" style="width:100%;margin-top:10px">دخول</button>
  <p id="lerr" style="color:var(--red);margin-top:10px;font-size:14px"></p>
</section>

<section id="panel">
  <header>
    <img src="logo.png" alt="">
    <h1>لوحة المشرف</h1>
    <a class="btn" href="index.html">المعرض</a>
    <button class="btn" id="out">خروج</button>
  </header>

  <div id="drop">
    <div style="font-size:34px">🖼️</div>
    <p>اسحب الصور هنا أو اخترها من جهازك</p>
    <button class="btn sky" id="pick">اختيار صور</button>
  </div>
  <input type="file" id="file" accept="image/*" multiple hidden>

  <div id="queueBox" style="display:none">
    <div class="grid" id="queue"></div>
    <div class="bar" id="bar"><i></i></div>
    <button class="btn pri" id="go">رفع <span id="n">0</span> صورة</button>
    <button class="btn" id="clear">مسح القائمة</button>
  </div>
  <p id="msg"></p>

  <h2>الصور في المعرض <small id="total" style="font-weight:400;color:#4a6a98"></small></h2>
  <div class="grid" id="lib"></div>
</section>
</div>
<div id="toast"></div>

<script>
/* ===== نفس إعدادات index.html ===== */
const SUPABASE_URL = "";
const SUPABASE_KEY = "";
const BUCKET = "gallery";
/* ================================== */

const $=id=>document.getElementById(id);
const sb=(SUPABASE_URL&&SUPABASE_KEY)?supabase.createClient(SUPABASE_URL,SUPABASE_KEY):null;
let queue=[], lib=[];
const toast=t=>{const e=$('toast');e.textContent=t;e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',2400)};

/* ---- دخول ---- */
function enter(){ $('login').style.display='none'; $('panel').style.display='block'; loadLib() }
async function init(){
  if(!sb){ enter(); $('msg').textContent='وضع تجريبي: أضف بيانات Supabase ليتم الحفظ فعليًا.'; return }
  const {data}=await sb.auth.getSession(); if(data.session) enter();
}
$('doLogin').onclick=async()=>{
  if(!sb){ enter(); return }
  const {error}=await sb.auth.signInWithPassword({email:$('em').value.trim(),password:$('pw').value});
  if(error) $('lerr').textContent='البريد أو كلمة المرور غير صحيحة'; else enter();
};
$('pw').onkeydown=e=>{if(e.key==='Enter')$('doLogin').click()};
$('out').onclick=async()=>{ if(sb) await sb.auth.signOut(); location.reload() };

/* ---- اختيار الصور ---- */
$('pick').onclick=()=>$('file').click();
$('file').onchange=e=>{addFiles(e.target.files);e.target.value=''};
const drop=$('drop');
['dragenter','dragover'].forEach(v=>drop.addEventListener(v,e=>{e.preventDefault();drop.classList.add('hot')}));
['dragleave','drop'].forEach(v=>drop.addEventListener(v,e=>{e.preventDefault();drop.classList.remove('hot')}));
drop.addEventListener('drop',e=>addFiles(e.dataTransfer.files));

function addFiles(fl){
  [...fl].filter(f=>f.type.startsWith('image/')).forEach(f=>queue.push({file:f,url:URL.createObjectURL(f)}));
  drawQueue();
}
function drawQueue(){
  $('queueBox').style.display=queue.length?'block':'none';
  $('n').textContent=queue.length;
  const q=$('queue'); q.innerHTML='';
  queue.forEach((it,i)=>{
    const c=document.createElement('div'); c.className='cell'; it.el=c;
    c.innerHTML=`<img src="${it.url}" alt=""><button aria-label="حذف">✕</button>`;
    c.querySelector('button').onclick=()=>{queue.splice(i,1);drawQueue()};
    q.appendChild(c);
  });
}
$('clear').onclick=()=>{queue=[];drawQueue()};

/* ---- ضغط + رفع متوازي ---- */
async function shrink(file,max,q){
  const bmp=await createImageBitmap(file,{imageOrientation:'from-image'});
  const r=Math.min(1,max/Math.max(bmp.width,bmp.height)),w=Math.round(bmp.width*r),h=Math.round(bmp.height*r);
  const c=typeof OffscreenCanvas!=='undefined'?new OffscreenCanvas(w,h):Object.assign(document.createElement('canvas'),{width:w,height:h});
  c.getContext('2d').drawImage(bmp,0,0,w,h);
  return c.convertToBlob?c.convertToBlob({type:'image/jpeg',quality:q}):new Promise(r=>c.toBlob(r,'image/jpeg',q));
}
$('go').onclick=async()=>{
  const items=queue.slice(); if(!items.length)return;
  $('go').disabled=true; $('bar').style.display='block'; const bar=$('bar').firstElementChild;
  let done=0,failed=0,k=0; const tick=()=>{bar.style.width=(++done/items.length*100)+'%'};
  const work=async it=>{
    try{
      const [full,thumb]=await Promise.all([shrink(it.file,1800,.82),shrink(it.file,420,.7)]);
      if(sb){
        const name=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,8)+'.jpg';
        const o={contentType:'image/jpeg',cacheControl:'31536000'};
        const [a,b]=await Promise.all([sb.storage.from(BUCKET).upload('full/'+name,full,o),sb.storage.from(BUCKET).upload('thumb/'+name,thumb,o)]);
        if(a.error||b.error) throw (a.error||b.error);
      }
      it.ok=true; it.el.classList.add('ok');
    }catch(e){ failed++; it.el.classList.add('bad'); console.error(e) }
    tick();
  };
  await Promise.all(Array.from({length:4},async()=>{while(k<items.length)await work(items[k++])}));
  queue=queue.filter(i=>!i.ok);
  toast(failed?`تم رفع ${items.length-failed} وفشل ${failed}`:`تم رفع ${items.length} صورة ✓`);
  setTimeout(()=>{ $('bar').style.display='none'; bar.style.width='0'; $('go').disabled=false; drawQueue(); loadLib() },900);
};

/* ---- الصور الحالية + الحذف ---- */
async function loadLib(){
  if(!sb){ $('total').textContent=''; return }
  const {data,error}=await sb.storage.from(BUCKET).list('full',{limit:2000,sortBy:{column:'created_at',order:'desc'}});
  if(error){ toast('تعذر تحميل الصور'); return }
  lib=data.filter(f=>f.name&&!f.name.startsWith('.'));
  $('total').textContent='('+lib.length+')';
  const g=$('lib'); g.innerHTML='';
  lib.forEach(f=>{
    const c=document.createElement('div'); c.className='cell';
    const u=sb.storage.from(BUCKET).getPublicUrl('thumb/'+f.name).data.publicUrl;
    c.innerHTML=`<img loading="lazy" src="${u}" alt=""><button aria-label="حذف">🗑</button>`;
    c.querySelector('button').onclick=async()=>{
      if(!confirm('حذف هذه الصورة نهائيًا؟'))return;
      const {error}=await sb.storage.from(BUCKET).remove(['full/'+f.name,'thumb/'+f.name]);
      if(error) toast('تعذر الحذف'); else { toast('تم الحذف'); loadLib() }
    };
    g.appendChild(c);
  });
}
init();
</script>
</body>
</html>
